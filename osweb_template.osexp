	run practice_wait_sequence

define sequence practice_wait_sequence
	set flush_keyboard yes
	set description "Wraps practice_wait_tick so practice_wait_loop (a loop) can run it - OSweb loops can only run sequences"
	run practice_wait_tick True

define sketchpad practice_wait_tick
	set duration 10
	set description "Tiny 10ms tick used to poll practice_ready without freezing the browser"

define keyboard_response thank_you_keypress
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Wait for space before redirect"
	set allowed_responses space

define sketchpad thank_you_screen
	set duration 0
	set description "Thank you page before Qualtrics redirect"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=True text="<b>End of part 1</b><br /><br />You will now be redirected to a short Qualtrics survey.<br /><br /><b>It is very important that you complete this survey.</b><br />Without completing it, we cannot process your<br />payment or SONA credits.<br /><br />Press SPACE to continue to the survey." x=0 y=0 z_index=0

define loop trial_loop
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "One iteration per video"
	set cycles 8
	set continuous no
	set break_if_on_first yes
	set break_if False
	setcycle 0 video_code "[video1]"
	setcycle 0 position 1
	setcycle 1 video_code "[video2]"
	setcycle 1 position 2
	setcycle 2 video_code "[video3]"
	setcycle 2 position 3
	setcycle 3 video_code "[video4]"
	setcycle 3 position 4
	setcycle 4 video_code "[video5]"
	setcycle 4 position 5
	setcycle 5 video_code "[video6]"
	setcycle 5 position 6
	setcycle 6 video_code "[video7]"
	setcycle 6 position 7
	setcycle 7 video_code "[video8]"
	setcycle 7 position 8
	run trial_sequence

define sequence trial_sequence
	set flush_keyboard yes
	set description "Video + familiarity per trial, with a mid-experiment attention check after video 4"
	run video_play True
	run video_wait_loop True
	run attention_check_1 "[position] == 4"
	run new_logger_attention "[position] == 4"
	run familiarity_question True
	run keyboard_familiarity True
	run new_logger True

define inline_javascript video_play
	set description "Plays main video with overlay instruction and records spaces. Sets vars.video_ready=1 only when truly finished; video_wait_loop blocks OSweb until then. DOM setup is delayed 60ms so any pending OSweb screen-transition (e.g. right after the rapid-fire Counterbalance_script/init_video_count items before video 1) finishes first, instead of wiping our overlay right after we insert it."
	___run__
	(function () {
	  vars.space_times = "";
	  vars.n_spaces = 0;
	  vars.video_error = "";
	  vars.video_ready = 0;
	  var code = "";
	  try { code = String(vars.video_code || "").trim(); } catch (e) { code = ""; }
	  function looksLikeUrl(s) { return /^https?:\/\//i.test(s); }
	  var url = "";
	  if (looksLikeUrl(code)) {
	    url = code;
	  } else if (code) {
	    try { url = String(vars[code] || "").trim(); } catch (e) { url = ""; }
	  }
	  if (!url) {
	    vars.video_error = "no_url_for_code:" + code;
	    vars.video_ready = 1;
	    return;
	  }
	  url = url.replace(/([?&])dl=\d+/g, "$1raw=1");
	  if (url.indexOf("raw=1") === -1) {
	    url += (url.indexOf("?") === -1 ? "?" : "&") + "raw=1";
	  }
	  setTimeout(function () {
	    var main = document.getElementsByTagName("main")[0];
	    if (main) main.style = "display: none";
	    var wrapper = document.createElement("div");
	    wrapper.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;background:#3d3846;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;";
	    var instr = document.createElement("div");
	    instr.style.cssText = "color:white;font-family:monospace;font-size:18px;margin-bottom:16px;text-align:center;padding:0 20px;";
	    instr.innerHTML = "Press <b>SPACEBAR</b> whenever you think a new event begins.";
	    var video = document.createElement("video");
	    video.src = url;
	    video.preload = "auto";
	    video.controls = false;
	    video.muted = false;
	    video.volume = 1.0;
	    video.setAttribute("playsinline", "");
	    video.style.cssText = "width:720px;max-width:90%;background:black;display:block;";
	    wrapper.appendChild(instr);
	    wrapper.appendChild(video);
	    document.body.appendChild(wrapper);
	    var t0 = null;
	    var pressLog = [];
	    var settled = false;
	    function onKeyDown(e) {
	      if (t0 === null) return;
	      var isSpace = (e.code === "Space" || e.key === " " || e.key === "Spacebar");
	      if (!isSpace) return;
	      e.preventDefault();
	      var t = Math.round(performance.now() - t0);
	      pressLog.push(t);
	      vars.n_spaces = pressLog.length;
	      vars.space_times = pressLog.join(",");
	    }
	    document.addEventListener("keydown", onKeyDown);
	    video.addEventListener("playing", function () {
	      if (t0 === null) t0 = performance.now();
	      // The video actually started - stallTimer only exists to catch a video
	      // that never begins (broken link that hangs). Clear it here so it can
	      // not cut off a video that is simply longer than 30s and playing fine.
	      clearTimeout(stallTimer);
	    });
	    function cleanup() {
	      document.removeEventListener("keydown", onKeyDown);
	      try { video.pause(); } catch(e) {}
	      try { wrapper.remove(); } catch(e) {}
	      if (main) main.style = "";
	    }
	    function finish() {
	      if (settled) return;
	      settled = true;
	      cleanup();
	      vars.video_ready = 1;
	    }
	    // Safety net: if the video never starts (e.g. broken link that hangs),
	    // don't freeze the experiment forever - move on after 30s and flag it.
	    var stallTimer = setTimeout(function () {
	      if (settled) return;
	      vars.video_error = "stalled_or_failed_to_start:" + url;
	      finish();
	    }, 30000);
	    video.addEventListener("ended", function () {
	      clearTimeout(stallTimer);
	      vars.video_count = (vars.video_count || 0) + 1;
	      finish();
	    });
	    video.addEventListener("error", function () {
	      clearTimeout(stallTimer);
	      vars.video_error = "load_error:" + url;
	      finish();
	    });
	    var p = video.play();
	    if (p && p.catch) {
	      p.catch(function () {
	        document.body.addEventListener("click", function once() {
	          document.body.removeEventListener("click", once);
	          video.play();
	        }, { once: true });
	      });
	    }
	  }, 60);
	})();
	__end__
	set _prepare ""

define sequence video_trial
	set flush_keyboard yes
	set description "Main experiment"
	run CounterAssign_loop True

define loop video_wait_loop
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Blocks (via break_if) until video_play sets vars.video_ready = 1. This is the safe, native OpenSesame way to wait for an async event - no JS return/Promise involved."
	set cycles 12000
	set continuous no
	set break_if_on_first yes
	set break_if "[video_ready] == 1"
	setcycle 0 dummy 0
