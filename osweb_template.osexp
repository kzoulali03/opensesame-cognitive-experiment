	run video_wait_sequence

define sequence video_wait_sequence
	set flush_keyboard yes
	set description "Wraps video_wait_tick so video_wait_loop (a loop) can run it - OSweb loops can only run sequences"
	run video_wait_tick True

define sketchpad video_wait_tick
	set duration 10
	set description "Tiny 10ms tick used to poll video_ready without freezing the browser (real blocking is done via video_wait_loop's break_if)"

define sketchpad welcome
	set duration keypress
	set description "Welcome screen"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=True text="<i>Welcome to the experiment!</i>  <br><br><br><b>Please read ALL the instructions carefully.</b><br /><br />Press SPACE to continue" x=0 y=0 z_index=0

