---
API: 3
OpenSesame: 4.1.8
Platform: posix
---
set width 1024
set title "New experiment"
set subject_parity even
set subject_nr 0
set start experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend osweb
set round_decimals 2
set mouse_backend osweb
set keyboard_backend osweb
set jatos_uuid ""
set height 768
set fullscreen no
set form_clicks no
set foreground white
set font_underline no
set font_size 18
set font_italic False
set font_family mono
set font_bold False
set experiment_path ""
set disable_garbage_collection False
set description "The main experiment item"
set color_backend osweb
set clock_backend osweb
set canvas_backend osweb
set background "#3d3846"

define loop CounterAssign_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Runs counterbalance script once"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if False
	setcycle 0 dummy 0
	run CounterLoop_sequence

define sequence CounterLoop_sequence
	set flush_keyboard yes
	set description "Counterbalance then trials (attention check now runs mid-sequence, after video 4)"
	run Counterbalance_script True
	run counterbalance_wait_loop True
	run init_video_count True
	run trial_loop True

define inline_javascript Counterbalance_script
	set description "Latin-square counterbalance: 8 videos per participant, FE/FU/NE/NU each 2x. Version (0-7) comes from a JATOS batch-session counter, so version cycles 0..7,0..7,... i.e. participant 9 gets exactly what participant 1 got. Falls back to studyResultId/subject_nr if batch session is unavailable (local test runs)."
	___run__
	// PUBLIC-SHARING VERSION: Video URLs below are placeholders. Replace each with an authorized video URL before running.
	var videos = {
	  BookfairFE:   "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  BookfairFU:   "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  BookfairNE:   "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  BookfairNU:   "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CafeFE:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CafeFU:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CafeNE:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CafeNU:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CharityFE:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CharityFU:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CharityNE:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  CharityNU:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  DoctorFE:     "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  DoctorFU:     "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  DoctorNE:     "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  DoctorNU:     "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GameFE:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GameFU:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GameNE:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GameNU:       "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GarderobeFE:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GarderobeFU:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GarderobeNE:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  GarderobeNU:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  LibraryFE:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  LibraryFU:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  LibraryNE:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  LibraryNU:    "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  StudyroomFE:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  StudyroomFU:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  StudyroomNE:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL",
	  StudyroomNU:  "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL"
	};
	// This order was taken directly from the 8 "OpenSesame Version" branches in
	// the Qualtrics survey (Final_Thesis_Qualtrics_7POINT_AROUSAL_MANDATORY_INSIGHT.qsf)
	// so that version N here always matches os_version (N+1) in Qualtrics exactly -
	// both which scenario-condition combinations appear AND their order.
	var versions = [
	  ["BookfairNE", "CafeNU", "CharityFU", "DoctorNU", "GarderobeFU", "LibraryNE", "StudyroomFE", "GameFE"],
	  ["GameNU", "BookfairFU", "CafeFE", "CharityNE", "DoctorNU", "GarderobeFE", "LibraryFU", "StudyroomNE"],
	  ["StudyroomFU", "GameNE", "BookfairNU", "CafeNE", "CharityFE", "DoctorFU", "GarderobeNU", "LibraryFE"],
	  ["LibraryNU", "StudyroomFU", "GameFE", "BookfairNU", "CafeNE", "CharityFE", "DoctorNE", "GarderobeFU"],
	  ["GarderobeNE", "LibraryFE", "StudyroomNU", "GameFU", "BookfairFE", "CafeFU", "CharityNU", "DoctorNE"],
	  ["DoctorFE", "GarderobeNU", "LibraryNE", "StudyroomFE", "GameFU", "BookfairNE", "CafeFU", "CharityNU"],
	  ["CharityFU", "DoctorFE", "GarderobeNE", "LibraryFU", "StudyroomNE", "GameNU", "BookfairFE", "CafeNU"],
	  ["CafeFE", "CharityNE", "DoctorFU", "GarderobeFE", "LibraryNU", "StudyroomNU", "GameNE", "BookfairFU"]
	];
	function assignVersion(version, sourceLabel, sourceValue) {
	  vars.counterbalance_version = version;
	  vars.counterbalance_source = sourceLabel;
	  vars.counterbalance_source_id = sourceValue;
	  var selectedVideos = versions[version];
	  for (var i = 0; i < 8; i++) {
	    var label = selectedVideos[i];
	    vars["Vid_Cond" + (i + 1)] = label;
	    vars["video" + (i + 1)] = videos[label];
	    // Scenario name without condition suffix, e.g. "Bookfair" - used for the dynamic attention check question
	    vars["Scenario" + (i + 1)] = label.replace(/(FE|FU|NE|NU)$/, "");
	  }
	  vars.n_videos = 8;
	  vars.video_sequence = selectedVideos.join(",");
	}

	function fallbackAssign(sourceLabel) {
	  // Used when JATOS batch session is unavailable (local test run) or kept
	  // conflicting after many retries. Not guaranteed to complete the exact
	  // 1-8-1-8 cycle, but still gives every participant *a* version.
	  var subj;
	  try {
	    if (window.jatos && jatos.studyResultId !== undefined && jatos.studyResultId !== null) {
	      subj = Number(jatos.studyResultId);
	    } else {
	      subj = Number(vars.subject_nr);
	    }
	  } catch (e) {
	    subj = Number(vars.subject_nr);
	  }
	  if (!isFinite(subj) || subj < 1) { subj = 1; }
	  assignVersion((subj - 1) % 8, sourceLabel, subj);
	}

	// Batch-session counter: increments once per participant, scoped to THIS
	// study's batch only (unlike jatos.studyResultId, which increments across
	// every study on the JATOS server). This is what makes participant 9 get
	// exactly the same version as participant 1.
	//
	// The run phase of an inline_javascript item in OSWeb cannot pause on
	// (await/return) a Promise - doing that throws "Illegal return statement".
	// So instead of returning a promise, this kicks the async claim off here
	// and lets it run in the background; vars.cb_ready flips to 1 once a
	// version has actually been assigned. counterbalance_wait_loop (the next
	// item in the sequence) blocks on that flag the same native, non-async way
	// video_wait_loop already blocks on vars.video_ready elsewhere in this file.
	//
	// jatos.batchSession.set() rejects if another participant's write raced
	// ahead of ours since our get() (JATOS's own conflict detection) - in that
	// case we re-read the now-current counter and try again, so two
	// participants starting at nearly the same instant still end up with
	// different versions instead of silently getting the same one.
	vars.cb_ready = 0;
	vars.cb_attempts = 0;

	function tryClaimVersion() {
	  vars.cb_attempts = (vars.cb_attempts || 0) + 1;
	  var current = jatos.batchSession.get("es_cb_counter");
	  if (current === undefined || current === null) { current = 0; }
	  jatos.batchSession.set("es_cb_counter", current + 1).then(
	    function() {
	      assignVersion(current % 8, "batch_session", current);
	      vars.cb_ready = 1;
	    },
	    function() {
	      // Write conflict - someone else updated the counter between our
	      // get() and set(). Re-read and retry with a small random delay.
	      if (vars.cb_attempts >= 20) {
	        fallbackAssign("fallback_after_batch_conflicts");
	        vars.cb_ready = 1;
	        return;
	      }
	      setTimeout(tryClaimVersion, 50 + Math.floor(Math.random() * 150));
	    }
	  );
	}

	if (window.jatos && window.jatos.batchSession) {
	  tryClaimVersion();
	} else {
	  // No JATOS batch session available (e.g. local desktop/browser test run).
	  fallbackAssign("no_jatos_local_test");
	  vars.cb_ready = 1;
	}
	__end__
	set _prepare ""

define loop counterbalance_wait_loop
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Blocks (via break_if) until Counterbalance_script's async batch-session claim finishes and sets vars.cb_ready = 1. Same native OpenSesame wait pattern as video_wait_loop - no JS return/Promise involved."
	set cycles 6000
	set continuous no
	set break_if_on_first yes
	set break_if "[cb_ready] == 1"
	setcycle 0 dummy 0
	setcycle 1 dummy ""
	setcycle 2 dummy ""
	setcycle 3 dummy ""
	setcycle 4 dummy ""
