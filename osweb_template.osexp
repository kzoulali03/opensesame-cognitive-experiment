define sequence counterbalance_wait_sequence
	set flush_keyboard yes
	set description "Wraps counterbalance_wait_tick so counterbalance_wait_loop (a loop) can run it - OSweb loops can only run sequences"
	run counterbalance_wait_tick True

define sketchpad counterbalance_wait_tick
	set duration 10
	set description "Tiny 10ms tick used to poll cb_ready without freezing the browser (real blocking is done via counterbalance_wait_loop's break_if)"

define form_text_input attention_check_1
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var attention_response_1
	set form_title "Attention check"
	set form_question "Could you briefly describe what specifically happened in the video you just watched ([Scenario4])? (press ENTER to continue)"
	set description "Attention check shown mid-experiment, after video 4 - asks specifically about the video just watched"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define form_consent consent_form
	set timeout infinite
	set spacing 10
	set rows "1;4;1;1"
	set only_render no
	set margins "50;50;50;50"
	set form_title "Consent form"
	__form_text__
	<div style="text-align: center; max-width: 800px; margin: 0 auto; line-height: 1.8; font-size: 1.1rem;">
	    You are about to participate in an experiment. This experiment poses no known risks to your health and your name will not be associated with the findings. Upon completion of your participation in this study you will be provided with a brief explanation of the question this study addresses. If you have any questions not addressed by this consent form, please do not hesitate to ask. Since it is an online study you can stop at any time during experiment. Please be aware that you will receive SONA study credits or monetary compensation only if you complete the study. If you stop early, no credits or compensation will be awarded.
	</div>
	__end__
	set description "Consent form"
	set decline_text "Do not participate"
	set decline_message "You need to accept the consent form to participate!"
	set cols "2;2"
	set checkbox_text "I have read and understood the information shown above"
	set accept_text "Participate!"
	set _theme gray
	widget 0 0 2 1 label text="{form_title}"
	widget 0 1 2 1 label center=no text="{form_text}"
	widget 0 2 2 1 checkbox text="{checkbox_text}" var=checkbox_status
	widget 0 3 1 1 button text="{accept_text}" var=accept_status
	widget 1 3 1 1 button text="{decline_text}"


define inline_javascript end_redirect
	set description "Redirects to Qualtrics, passing os_version (1-8, matches the Qualtrics branch logic) plus jatos_worker_id, jatos_study_result_id, jatos_component_result_id, subject_nr, participant_id and video1_code..video8_code, matching the embedded data fields defined in the Qualtrics survey flow."
	___run__
	var qualtricsURL = "https://example.org/REPLACE_WITH_AUTHORIZED_SURVEY_URL";
	try {
	  var workerId = "unknown";
	  var studyResultId = "";
	  var componentResultId = "";
	  if (window.jatos) {
	    workerId = jatos.workerId || "unknown";
	    studyResultId = (jatos.studyResultId !== undefined && jatos.studyResultId !== null) ? jatos.studyResultId : "";
	    componentResultId = (jatos.componentResultId !== undefined && jatos.componentResultId !== null) ? jatos.componentResultId : "";
	  }
	  // os_version is 1-indexed because the Qualtrics branch logic checks
	  // "os_version == 1" .. "os_version == 8"; counterbalance_version here is
	  // 0-indexed, hence the +1.
	  var osVersion = (vars.counterbalance_version !== undefined && vars.counterbalance_version !== null)
	    ? (Number(vars.counterbalance_version) + 1) : "";
	  var params = {
	    os_version: osVersion,
	    jatos_worker_id: workerId,
	    jatos_study_result_id: studyResultId,
	    jatos_component_result_id: componentResultId,
	    subject_nr: vars.subject_nr,
	    // Participant identifier supplied through the optional Prolific ID field
	    // and passed to the survey for participant-level matching.
	    // Verify consent and institutional permissions before collecting identifiers.
	    participant_id: vars.prolific_id || "",
	    video1_code: vars.Vid_Cond1 || "",
	    video2_code: vars.Vid_Cond2 || "",
	    video3_code: vars.Vid_Cond3 || "",
	    video4_code: vars.Vid_Cond4 || "",
	    video5_code: vars.Vid_Cond5 || "",
	    video6_code: vars.Vid_Cond6 || "",
	    video7_code: vars.Vid_Cond7 || "",
	    video8_code: vars.Vid_Cond8 || ""
	  };
	  var queryParts = [];
	  for (var key in params) {
	    if (params.hasOwnProperty(key)) {
	      queryParts.push(encodeURIComponent(key) + "=" + encodeURIComponent(params[key]));
	    }
	  }
	  var fullURL = qualtricsURL + "?" + queryParts.join("&");
	  if (window.jatos) {
	    jatos.endStudyAndRedirect(fullURL);
	  } else {
	    window.location.href = fullURL;
	  }
	} catch(e) {
	  window.location.href = qualtricsURL;
	}
	__end__
	set _prepare ""

define inline_javascript end_study_exclusion
	set description "Ends the JATOS study for excluded participants without redirecting to the Qualtrics survey"
	___run__
	try {
	  if (window.jatos && jatos.endStudy) {
	    jatos.endStudy(false);
	  }
	} catch (e) {}
	__end__
	set _prepare ""

define sketchpad exclusion_screen
	set duration keypress
	set description "Shown to participants who indicated meeting one or more exclusion criteria"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=20 html=yes show_if=True text="<b>Thank you for your interest in this study.</b><br /><br />Unfortunately, you cannot participate because you indicated<br />that one or more of the participation criteria apply to you.<br /><br />You may now close this window.<br /><br />Press SPACE to close." x=0 y=0 z_index=0

define sequence experiment
	set flush_keyboard yes
	set description "Runs a number of items in sequence. Excluded participants (meeting one or more exclusion criteria) are stopped in participantinfo_sequence and skip everything below."
	run participantinfo_sequence True
	run practice_instructions "[excluded] == 0"
	run practice_video_loop "[excluded] == 0"
	run practice_done_sketchpad "[excluded] == 0"
	run main_instructions "[excluded] == 0"
	run video_trial "[excluded] == 0"
	run thank_you_screen "[excluded] == 0"
	run thank_you_keypress "[excluded] == 0"
	run end_redirect "[excluded] == 0"

define sketchpad familiarity_question
	set duration 0
	set description "Familiarity rating scale"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text="How familiar was this scenario for you? <br> <br>" x=0 y=0 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text="Not familiar at all <br> <br>" x=-300 y=250 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text="Extremely familiar <br> <br>" x=300 y=250 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text=1 x=-300 y=180 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text=7 x=300 y=180 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text=4 x=0 y=180 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text=2 x=-200 y=180 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text=3 x=-100 y=180 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text=5 x=100 y=180 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text=6 x=200 y=180 z_index=0

define inline_javascript import_jatos_id
	set description "Imports JATOS worker ID safely"
	___run__
	try {
	  if (window.jatos) {
	    vars.jatos_worker_id = jatos.workerId || "unknown";
	  } else {
	    vars.jatos_worker_id = "not_in_jatos";
	  }
	} catch(e) {
	  vars.jatos_worker_id = "error";
	}
	__end__
	set _prepare ""

define inline_javascript init_video_count
	set description "Initialises video counter"
	set _run "vars.video_count = 0;"
	set _prepare ""

define keyboard_response keyboard_familiarity
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Records familiarity rating"
	set allowed_responses "1;2;3;4;5;6;7"

define sketchpad main_instructions
	set duration keypress
	set description "Final reminder before main videos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=20 html=yes show_if=True text="You will now watch the study videos.<br /><br />As before: press <b>SPACEBAR</b> whenever you think<br />a new event begins.<br /><br />After each video you will answer a short question.<br /><br />Press SPACE to begin." x=0 y=0 z_index=0

define inline_javascript exclusion_check
	set description "Flags participant as excluded if they indicated meeting any of the exclusion criteria (kept non-specific: which criterion applied is not recorded)"
	set _run "vars.excluded = (String(vars.response_exclusion_response).toLowerCase() === 'y') ? 1 : 0;"
	set _prepare ""

define keyboard_response exclusion_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Records combined exclusion-criteria yes/no response"
	set allowed_responses "y;n"

define sketchpad exclusion_criteria_screen
	set duration 0
	set description "Combined exclusion-criteria question - shown before the keyboard Y/N response. Kept non-specific per supervisor guidance so the specific reason for exclusion cannot be inferred from the response."
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=20 html=yes show_if=True text="<b>Participation criteria</b><br /><br />Please read the criteria below. You cannot take part in this study if ANY of the following apply to you:<br /><br />&nbsp;&nbsp;- You are younger than 18 or older than 35 years old<br />&nbsp;&nbsp;- You currently have psychological or neurological symptoms or complaints<br />&nbsp;&nbsp;- You are currently taking medication that influences psychological, neurological, or cognitive functioning (e.g., ADHD medication)<br />&nbsp;&nbsp;- You do NOT have normal vision, or normal corrected-to-normal vision (e.g., without glasses/lenses if you need them)<br /><br />Does ANY of the above apply to you?<br /><br />Press <b>Y</b> for YES &nbsp;&nbsp;&nbsp;&nbsp; Press <b>N</b> for NO" x=0 y=0 z_index=0

define form_text_input new_form_text_input
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var response
	set form_title Age
	set form_question "What is your age (in years, only digits)?"
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define form_text_input prolific_id_form
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var prolific_id
	set form_title "Prolific ID"
	set form_question "What is your Prolific ID? (If you do not have one, leave this blank and press ENTER to skip)"
	set description "Optional Prolific ID input - blank + ENTER skips it"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define logger new_logger
	set description "Logs trial data incl. space_times and n_spaces"
	set auto_log yes

define logger new_logger_attention
	set description "Logs attention check response"
	set auto_log yes

define sequence participantinfo_sequence
	set flush_keyboard yes
	set description "Participant info screens, with exclusion branch based on the combined (non-specific) exclusion-criteria question"
	run welcome True
	run import_jatos_id True
	run consent_form True
	run exclusion_criteria_screen True
	run exclusion_response True
	run exclusion_check True
	run exclusion_screen "[excluded] == 1"
	run end_study_exclusion "[excluded] == 1"
	run new_form_text_input "[excluded] == 0"
	run prolific_id_form "[excluded] == 0"
	run new_logger "[excluded] == 0"

define sketchpad practice_done_sketchpad
	set duration keypress
	set description "Shown after practice is completed successfully"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=True text="<b>Well done!</b><br /><br />You pressed the spacebar during the video.<br /><br />Now the real experiment will begin.<br />The instructions are the same: press <b>SPACEBAR</b><br />whenever you think a new event begins.<br /><br />Press SPACE to continue." x=0 y=0 z_index=0

define sketchpad practice_instructions
	set duration keypress
	set description "Instructions before practice video"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=True text="<b>Practice</b><br /><br />You will first watch a short practice video.<br /><br />While watching, press <b>SPACEBAR</b> every time you feel<br />a new event or scene begins — for example when<br />the action, location, or goal changes.<br /><br />There is no right or wrong answer.<br />Just press when it feels natural to you.<br /><br />Press SPACE to start the practice video." x=0 y=0 z_index=0

define sequence practice_trial_sequence
	set flush_keyboard yes
	set description "Practice video with built-in replay loop"
	run practice_video_play True
	run practice_wait_loop True

define loop practice_video_loop
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Single cycle - replay handled inside JavaScript"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if False
	setcycle 0 dummy 0
	run practice_trial_sequence

define inline_javascript practice_video_play
	set description "Plays practice video, replays with warning if no spaces pressed. Sets vars.practice_ready=1 only once a full replay with >=1 press is done; practice_wait_loop blocks OSweb until then."
	___run__
	(function () {
	  vars.practice_ready = 0;
	  function startPractice(isRetry) {
	    vars.practice_spaces = 0;
	    vars.practice_space_times = "";
	    var main = document.getElementsByTagName("main")[0];
	    if (main) main.style = "display: none";
	    var practiceURL = "https://example.org/REPLACE_WITH_AUTHORIZED_VIDEO_URL";
	    practiceURL = practiceURL.replace(/([?&])dl=\d+/g, "$1raw=1");
	    if (practiceURL.indexOf("raw=1") === -1) {
	      practiceURL += (practiceURL.indexOf("?") === -1 ? "?" : "&") + "raw=1";
	    }
	    var wrapper = document.createElement("div");
	    wrapper.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;background:#3d3846;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;";
	    if (isRetry) {
	      var warning = document.createElement("div");
	      warning.style.cssText = "color:#ffcc00;font-family:monospace;font-size:17px;margin-bottom:14px;text-align:center;padding:0 20px;max-width:720px;";
	      warning.innerHTML = "<b>It looks like you did not press the spacebar.</b><br />Please press <b>SPACEBAR</b> whenever you feel a new event begins.";
	      wrapper.appendChild(warning);
	    }
	    var instr = document.createElement("div");
	    instr.style.cssText = "color:white;font-family:monospace;font-size:18px;margin-bottom:16px;text-align:center;padding:0 20px;";
	    instr.innerHTML = "Press <b>SPACEBAR</b> whenever you think a new event begins.";
	    wrapper.appendChild(instr);
	    var video = document.createElement("video");
	    video.src = practiceURL;
	    video.preload = "auto";
	    video.controls = false;
	    video.muted = false;
	    video.volume = 1.0;
	    video.setAttribute("playsinline", "");
	    video.style.cssText = "width:720px;max-width:90%;background:black;display:block;";
	    wrapper.appendChild(video);
	    document.body.appendChild(wrapper);
	    var t0 = null;
	    var pressLog = [];
	    var settled = false;
	    function onKeyDown(e) {
	      if (t0 === null) return;
	      var isSpace = (e.code === "Space" || e.key === " " || e.key === "Spacebar");
	      if (!isSpace) return;
	      e.preventDefault();
	      var t = Math.round(performance.now() - t0);
	      pressLog.push(t);
	      vars.practice_spaces = pressLog.length;
	      vars.practice_space_times = pressLog.join(",");
	    }
	    document.addEventListener("keydown", onKeyDown);
	    video.addEventListener("playing", function () {
	      if (t0 === null) t0 = performance.now();
	      // The video actually started - stallTimer only exists to catch a video
	      // that never begins (broken link that hangs). Clear it here so it can
	      // not cut off a video that is simply longer than 30s and playing fine.
	      clearTimeout(stallTimer);
	    });
	    function cleanup() {
	      document.removeEventListener("keydown", onKeyDown);
	      try { video.pause(); } catch(e) {}
	      try { wrapper.remove(); } catch(e) {}
	      if (main) main.style = "";
	    }
	    var stallTimer = setTimeout(function () {
	      if (settled) return;
	      settled = true;
	      vars.video_error = "practice_stalled_or_failed_to_start";
	      cleanup();
	      vars.practice_ready = 1;
	    }, 30000);
	    video.addEventListener("ended", function () {
	      if (settled) return;
	      settled = true;
	      clearTimeout(stallTimer);
	      cleanup();
	      if (pressLog.length === 0) {
	        // No spaces pressed: restart automatically with warning, keep practice_ready at 0
	        setTimeout(function() { startPractice(true); }, 400);
	      } else {
	        vars.practice_ready = 1;
	      }
	    });
	    video.addEventListener("error", function () {
	      if (settled) return;
	      settled = true;
	      clearTimeout(stallTimer);
	      vars.video_error = "practice_load_error";
	      cleanup();
	      alert("Practice video could not be loaded. Please check your internet connection.");
	      vars.practice_ready = 1;
	    });
	    var p = video.play();
	    if (p && p.catch) {
	      p.catch(function () {
	        document.body.addEventListener("click", function once() {
	          document.body.removeEventListener("click", once);
	          video.play();
	        }, { once: true });
	      });
	    }
	  }
	  startPractice(false);
	})();
	__end__
	set _prepare ""

